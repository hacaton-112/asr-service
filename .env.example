WHISPER_HOST=0.0.0.0
WHISPER_PORT=8787
# Optional. The service also checks the trainer-client legacy AppData model directory.
WHISPER_MODEL_PATH=./models/ggml-large-v3-turbo.bin
WHISPER_PUBLIC_WS_URL=ws://127.0.0.1:8787
WHISPER_PARTIAL_INTERVAL_MS=1200
RUST_LOG=asr_service=info,tower_http=info

# Только для docker-compose.yml (нативный запуск использует WHISPER_MODEL_PATH
# выше). Папка на хосте с *.bin моделями, монтируется в контейнер как /models.
# WHISPER_MODELS_DIR=C:/Users/<you>/AppData/Roaming/com.rizo.trainer-client/whisper-models
# WHISPER_MODEL_FILE=ggml-large-v3-turbo.bin
